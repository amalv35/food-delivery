# Dependencies
node_modules/
package-lock.json # Optional: Keep this if you want to lock versions, ignore if you don't. usually recommended to COMMIT this.
yarn.lock

# Environment Variables (CRITICAL: Never commit these)
.env
.env.test
.env.production
.env.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# NYC coverage support
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
jspm_packages/

# TypeScript v1 declaration files
typings/

# TypeScript cache
*.tsbuildinfo

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv-linter
.env.lint

# IDE / Editor configurations
.idea/
.vscode/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# Operating System files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# MongoDB specific
# If you run mongodump locally, you don't want to commit the dump
dump/
data/db/

# Build folders (if you are using TypeScript or Babel)
dist/
build/

# Uploads (If your backend handles file uploads locally)
uploads/
# keep the folder structure but ignore content (optional)
!uploads/.gitkeep